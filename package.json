{
  "name": "app",
  "private": true,
  "engines": {
    "node": "20.x",
    "yarn": "1.x"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --minify --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "tailwindcss -i ./app/frontend/styles/application.css -o ./app/assets/builds/application.css --minify"
  }
}
