<%#
  The assistant and its CRM side by side: a customer conversation on the
  left, the record it produces on the right. Two sample conversations — one
  the assistant resolves, one it hands to sales. The copy lives in the locale
  files so both run in either language; visuals/assistant.js plays them.
%><%
  v = "pages.product.projects.assistant.visual"
  scenarios = Array(t("#{v}.scenarios"))
  first = scenarios.first
%>
<figure class="min-w-0" data-reveal style="--reveal-delay:120ms">
  <div data-assistant-visual aria-hidden="true"
       data-scenarios="<%= scenarios.to_json %>"
       class="crop visual-window overflow-hidden border border-line bg-ink-900">

    <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-3.5">
      <span class="label text-fg-muted">assistant / <%= t("#{v}.window") %></span>
      <span class="label"><%= t("common.illustrative") %></span>
    </div>

    <div class="grid sm:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <%# --- Chat --- %>
      <div class="flex min-h-[21rem] flex-col border-line sm:border-r">
        <ol data-assistant-chat class="flex flex-1 flex-col justify-end gap-3 p-4 sm:p-5">
          <li class="chat-msg is-user"><%= first[:question] %></li>
          <li class="chat-msg is-bot">
            <span data-chat-text><%= first[:answer] %></span>
            <span class="chat-source"><%= t("#{v}.source") %> · <%= first[:source] %></span>
          </li>
        </ol>
        <div class="flex items-center gap-3 border-t border-line px-4 py-3 sm:px-5">
          <span class="flex-1 truncate text-[0.8125rem] text-fg-faint"><%= t("#{v}.placeholder") %></span>
          <span class="grid h-7 w-7 place-items-center rounded-full bg-lime text-ink-950" aria-hidden="true">&uarr;</span>
        </div>
      </div>

      <%# --- CRM record --- %>
      <div class="border-t border-line p-4 sm:border-t-0 sm:p-5">
        <div class="flex items-center justify-between gap-3">
          <span class="label">CRM · <%= t("#{v}.record") %></span>
          <span class="crm-live" data-crm-live><span></span> live</span>
        </div>
        <dl class="mt-5 space-y-4 text-[0.8125rem]">
          <% %w[intent status].each do |field| %>
            <div>
              <dt class="label"><%= t("#{v}.fields.#{field}") %></dt>
              <dd class="mt-1.5 text-fg" data-crm="<%= field %>"><%= first[field.to_sym] %></dd>
            </div>
          <% end %>
          <div>
            <dt class="label"><%= t("#{v}.fields.summary") %></dt>
            <dd class="mt-1.5 leading-relaxed text-fg-muted" data-crm="summary"><%= first[:summary] %></dd>
          </div>
          <div>
            <dt class="label"><%= t("#{v}.fields.tags") %></dt>
            <dd class="mt-2 flex flex-wrap gap-1.5" data-crm="tags">
              <% first[:tags].each do |tag| %><span class="crm-tag"><%= tag %></span><% end %>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
  <figcaption class="label mt-4"><%= t("#{v}.caption") %></figcaption>
</figure>
