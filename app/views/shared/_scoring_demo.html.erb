<%#
  An illustrative origination run: one application moves through the cycle,
  gets checked, scored and booked, while an event log scrolls beside it.

  The markup is the finished state of the first scenario, so without JS (or
  with motion reduced) it reads as a completed run. scoring_demo.js replays it
  and cycles through a few scenarios. Every value here is sample data and the
  card says so.
%><%
  d = "pages.home.demo"
  stages = %w[intake scoring compliance contract portfolio collections]
  checks = %w[kyc aml bureau collateral]
%>
<figure class="mt-14" data-reveal>
  <p class="sr-only"><%= t("#{d}.sr_summary") %></p>

  <div data-scoring-demo aria-hidden="true"
       data-label-months="<%= t("#{d}.months", count: "%{count}") %>"
       data-label-na="<%= t("#{d}.not_applicable") %>"
       data-label-approved="<%= t("#{d}.decisions.approved") %>"
       data-label-review="<%= t("#{d}.decisions.review") %>"
       data-products="<%= { auto: t("#{d}.products.auto"), consumer: t("#{d}.products.consumer"), mortgage: t("#{d}.products.mortgage") }.to_json %>"
       class="crop overflow-hidden border border-line bg-ink-900">

    <%# --- Window bar --- %>
    <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-3.5">
      <div class="flex items-center gap-3">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-lime opacity-60"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-lime"></span>
        </span>
        <span class="label text-fg-muted">origination / run</span>
      </div>
      <span class="label"><%= t("#{d}.note") %></span>
    </div>

    <%# --- Stage rail --- %>
    <ol class="grid grid-cols-6 border-b border-line">
      <% stages.each_with_index do |stage, i| %>
        <li data-demo-stage class="demo-stage is-done relative border-line px-3 py-3 [&:not(:last-child)]:border-r sm:px-4">
          <span class="label block"><%= format("%02d", i + 1) %></span>
          <span class="mt-1.5 hidden truncate text-[0.8125rem] tracking-[-0.01em] md:block"><%= t("pages.home.pipeline.stages.#{stage}") %></span>
          <span class="demo-stage-bar absolute inset-x-0 bottom-0 h-px"></span>
        </li>
      <% end %>
    </ol>

    <%# minmax(0, …) tracks: the log's unwrapped lines must clip, not widen the card. %>
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
      <%# --- Application --- %>
      <div class="border-line p-6 sm:p-8 lg:border-r">
        <dl class="grid grid-cols-2 gap-x-6 gap-y-5">
          <% { application: "APP-24817", product: t("#{d}.products.auto"), amount: euros(18_400), term: t("#{d}.months", count: 48) }.each do |key, value| %>
            <div>
              <dt class="label"><%= t("#{d}.fields.#{key}") %></dt>
              <dd class="mt-2 font-mono text-[0.9375rem] text-fg" data-demo-field="<%= key %>"><%= value %></dd>
            </div>
          <% end %>
        </dl>

        <ul class="mt-8 divide-y divide-line border-y border-line">
          <% checks.each do |check| %>
            <li class="demo-check is-pass flex items-center justify-between gap-4 py-3" data-demo-check="<%= check %>">
              <span class="text-[0.9375rem] text-fg-muted"><%= t("#{d}.checks.#{check}") %></span>
              <span class="demo-check-state label" data-demo-check-state>
                <span class="demo-check-icon" aria-hidden="true"></span>
                <span data-demo-check-text>OK</span>
              </span>
            </li>
          <% end %>
        </ul>

        <%# --- Score --- %>
        <div class="mt-8 flex items-end gap-6">
          <svg class="h-auto w-36 shrink-0 sm:w-44" viewBox="0 0 120 66" fill="none" aria-hidden="true">
            <path d="M10 60a50 50 0 0 1 100 0" stroke="var(--color-line-strong)" stroke-width="6" stroke-linecap="round"/>
            <%# Approval threshold tick, at 0.70 of the arc %>
            <path d="M10 60a50 50 0 0 1 100 0" stroke="var(--color-fg-faint)" stroke-width="10"
                  pathLength="100" stroke-dasharray="0.6 99.4" stroke-dashoffset="-70"/>
            <path data-demo-gauge d="M10 60a50 50 0 0 1 100 0" stroke="var(--color-lime)" stroke-width="6" stroke-linecap="round"
                  pathLength="100" stroke-dasharray="87 100"/>
          </svg>
          <div class="pb-1">
            <span class="label"><%= t("#{d}.score") %></span>
            <p class="mt-2 font-mono text-[2rem] leading-none tracking-[-0.03em] text-fg" data-demo-score>0.87</p>
            <p class="demo-decision is-approved mt-3 text-[0.9375rem] font-medium" data-demo-decision><%= t("#{d}.decisions.approved") %></p>
          </div>
        </div>
      </div>

      <%# --- Event log --- %>
      <div class="flex min-h-[20rem] min-w-0 flex-col border-t border-line lg:border-t-0">
        <div class="flex items-center justify-between border-b border-line px-6 py-3 sm:px-8">
          <span class="label"><%= t("#{d}.log") %></span>
          <span class="label text-fg-faint">tail -f</span>
        </div>
        <ol data-demo-log class="demo-log relative flex flex-1 flex-col justify-end overflow-hidden px-6 py-5 font-mono text-[0.75rem] leading-[1.9] sm:px-8">
          <% [
               ["intake.received", "id=APP-24817 channel=web"],
               ["score.computed", "model=scoring-v7 score=0.87"],
               ["decision.approved", "limit=EUR18400"],
               ["contract.generated", "esign=sent"],
               ["portfolio.booked", "schedule=48"]
             ].each do |event, detail| %>
            <li class="demo-log-line"><span class="text-lime"><%= event %></span> <span class="text-fg-faint"><%= detail %></span></li>
          <% end %>
        </ol>
      </div>
    </div>
  </div>

  <figcaption class="mt-4 flex items-center justify-between gap-4">
    <span class="label"><%= t("#{d}.caption") %></span>
  </figcaption>
</figure>
