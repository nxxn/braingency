<%#
  Stand-in portrait until real photographs arrive: a deterministic geometric
  field derived from the person's initials, so the two founders get visibly
  different marks and neither slot reads as a missing image.

  When a photo exists at app/assets/images/team/<seed>.jpg it is used
  instead: the real <img> is in the markup (alt text, no-JS, crawlers), and
  portrait_reveal.js lays a canvas over it that starts as the same lime cell
  grid as this placeholder and resolves into the photograph — a model
  converging, rather than an image fading in.

  locals: initials (String), seed (Symbol/String), name (String, alt text)
%><%
  seed = local_assigns[:seed].to_s
  photo = "team/#{seed}.jpg"
  has_photo = Rails.root.join("app/assets/images", photo).exist?
%>
<% if has_photo %>
<figure class="crop portrait-photo relative aspect-[4/5] w-full overflow-hidden border border-line bg-ink-900" data-portrait-reveal>
  <%= image_tag photo, alt: local_assigns[:name].to_s, class: "absolute inset-0 h-full w-full object-cover",
        loading: "lazy", decoding: "async", width: 800, height: 1000 %>
  <canvas class="portrait-canvas absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <span class="label absolute bottom-5 left-5 text-fg/80" aria-hidden="true"><%= initials %></span>
</figure>
<% else %><%

  # Stable pseudo-random from the seed: same person, same pattern, every build.
  rng = seed.each_byte.each_with_index.sum { |b, i| b * (i + 3) }
  cells = (0...36).map { |n| ((rng * (n + 7) * 2_654_435_761) >> 9) % 100 }
%>
<div class="crop relative aspect-[4/5] w-full overflow-hidden border border-line bg-ink-900">
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 60 75" preserveAspectRatio="xMidYMid slice"
       aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="pg-<%= seed %>" x1="0" y1="0" x2="0.7" y2="1">
        <stop offset="0%" stop-color="#CBFF4D" stop-opacity="0.85"/>
        <stop offset="100%" stop-color="#CBFF4D" stop-opacity="0.12"/>
      </linearGradient>
      <radialGradient id="pv-<%= seed %>" cx="0.34" cy="0.3" r="0.85">
        <stop offset="0%" stop-color="#CBFF4D" stop-opacity="0.16"/>
        <stop offset="100%" stop-color="#CBFF4D" stop-opacity="0"/>
      </radialGradient>
    </defs>

    <rect width="60" height="75" fill="url(#pv-<%= seed %>)"/>

    <%# Sparse cell field — roughly a third of the grid lights up %>
    <% cells.each_with_index do |v, n| %>
      <% next if v < 64 %>
      <% col = n % 6; row = n / 6 %>
      <rect x="<%= col * 10 %>" y="<%= row * 12.5 %>" width="10" height="12.5"
            fill="url(#pg-<%= seed %>)" opacity="<%= ((v % 45) + 30) / 200.0 %>"
            class="portrait-cell" style="animation-delay: -<%= (v * 97) % 7000 %>ms"/>
    <% end %>

    <%# Hairline grid %>
    <g stroke="#ffffff" stroke-opacity="0.07" stroke-width="0.25">
      <% (1..5).each do |c| %><line x1="<%= c * 10 %>" y1="0" x2="<%= c * 10 %>" y2="75"/><% end %>
      <% (1..5).each do |r| %><line x1="0" y1="<%= r * 12.5 %>" x2="60" y2="<%= r * 12.5 %>"/><% end %>
    </g>
  </svg>

  <%# Anchors the composition and identifies the person at a glance %>
  <span class="absolute bottom-6 left-6 font-mono text-[3.25rem] font-light leading-none tracking-[-0.05em] text-fg/80">
    <%= initials %>
  </span>

  <span class="label absolute right-5 top-5 text-fg-faint">Photo pending</span>
</div>
<% end %>
