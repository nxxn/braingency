<%#
  Geometric line icons, 24×24, stroked in currentColor.
  locals: name, class
%><%
  css_class = local_assigns[:class] || "h-6 w-6"
%>
<svg class="<%= css_class %>" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
  <% case name.to_s %>
  <% when "financial" %>
    <%# A ledger: framed rows of unequal length %>
    <rect x="3" y="3" width="18" height="18" rx="2.5"/>
    <path d="M7 8.5h10M7 12h6.5M7 15.5h8.5"/>

  <% when "ml" %>
    <%# A small graph: three nodes, two edges %>
    <path d="M7.6 9.4 15 6.6M8.2 14.4l6.4 3"/>
    <circle cx="6" cy="11" r="2.6"/>
    <circle cx="17.4" cy="5.6" r="2.6"/>
    <circle cx="17" cy="18.4" r="2.6"/>

  <% when "platforms" %>
    <%# Stacked planes %>
    <path d="M12 3 21 7.7 12 12.4 3 7.7 12 3Z"/>
    <path d="M3 12.2 12 16.9l9-4.7M3 16.6 12 21.3l9-4.7"/>

  <% when "research" %>
    <path d="M12 3v3.4M12 17.6V21M3 12h3.4M17.6 12H21"/>
    <circle cx="12" cy="12" r="5.6"/>
    <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>

  <% when "shield" %>
    <path d="M12 3 20 6v6.2c0 4.3-3.2 7.4-8 8.8-4.8-1.4-8-4.5-8-8.8V6l8-3Z"/>
    <path d="m8.8 12 2.3 2.3 4.1-4.6"/>

  <% when "download" %>
    <path d="M12 3.5v11M7.8 10.6 12 14.8l4.2-4.2M4 17.5v1.2A1.8 1.8 0 0 0 5.8 20.5h12.4a1.8 1.8 0 0 0 1.8-1.8v-1.2"/>

  <% when "arrow-up-right" %>
    <path d="M7 17 17 7M8.5 7H17v8.5"/>
  <% end %>
</svg>
