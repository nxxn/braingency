# Kamal secrets. Read as dotenv, one line at a time, so each line pulls its own
# value out of .env (which is gitignored).
KAMAL_REGISTRY_USER=$(grep -m1 '^KAMAL_REGISTRY_USER=' .env | cut -d= -f2-)
KAMAL_REGISTRY_PASSWORD=$(grep -m1 '^KAMAL_REGISTRY_PASSWORD=' .env | cut -d= -f2-)
RAILS_MASTER_KEY=$(cat config/master.key)
BRAINGENCY_DATABASE_PASSWORD=$(grep -m1 '^BRAINGENCY_DATABASE_PASSWORD=' .env | cut -d= -f2-)
ADMIN_USER=$(grep -m1 '^ADMIN_USER=' .env | cut -d= -f2-)
ADMIN_PASSWORD=$(grep -m1 '^ADMIN_PASSWORD=' .env | cut -d= -f2-)
